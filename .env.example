# ====================================================================
# Open 4Cs - Environment Configuration Example
# Copy this file to .env.local and adjust values for your environment.
# ====================================================================

# MongoDB Database Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/gemstone_evaluation
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/open4cs?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/gemstone_evaluation

# Session & JWT Secret Key (min 32 random characters for production)
SESSION_SECRET=your-random-32-character-session-secret-key-here

# NextAuth Configuration (Optional if using custom credentials session)
NEXTAUTH_SECRET=your-nextauth-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Base URL for public links and callback endpoints
NEXT_PUBLIC_APP_URL=http://localhost:3000
